[Unit]
Description=QQCS Security Camera Monitor
Documentation=https://github.com/akosthekiss/qqcs
# SPEC §29: must start after the graphical environment is ready, never from
# .bashrc/an autostart desktop entry.
After=graphical.target systemd-udev-settle.service
Wants=graphical.target
# Belong in [Unit], not [Service] -- systemd rejects them in [Service] on
# current releases (confirmed on Ubuntu 26.04).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=qqcs
Group=qqcs
SupplementaryGroups=video render input tty
# eglfs/KMS: renders directly to /dev/dri, no X11/Wayland compositor
# required. Recommended default for this always-on kiosk use case. The
# platform is chosen here, via environment, not compiled into the binary --
# the same executable also runs correctly on desktop Linux/macOS with no
# QT_QPA_PLATFORM override at all (Qt auto-detects xcb/wayland/cocoa there).
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/qqcs/kms.json
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QQCS_CONFIG=/etc/qqcs/config.yaml
ExecStart=/usr/bin/qqcs
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qqcs

[Install]
WantedBy=graphical.target
