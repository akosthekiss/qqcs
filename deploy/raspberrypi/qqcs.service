[Unit]
Description=QQCS Security Camera Monitor
Documentation=https://github.com/akosthekiss/qqcs
# SPEC §29: must start after the graphical environment is ready, never from
# .bashrc/an autostart desktop entry.
After=graphical.target systemd-udev-settle.service
Wants=graphical.target
# Belong in [Unit], not [Service] -- systemd rejects them in [Service] on
# current releases (confirmed on Ubuntu 26.04).
StartLimitIntervalSec=60
StartLimitBurst=5
# The packaged config.yaml is only ever an .example -- there is no valid
# default (the camera list is inherently site-specific, and an empty one
# fails validation). Rather than start, fail validation, and crash-loop
# (until StartLimitBurst above kicks in) on a fresh install, skip startup
# entirely -- inertly, not as a failure -- until the admin has copied and
# edited /etc/qqcs/config.yaml.example into place.
ConditionPathExists=/etc/qqcs/config.yaml

[Service]
Type=simple
User=qqcs
Group=qqcs
SupplementaryGroups=video render input tty audio
# eglfs/KMS: renders directly to /dev/dri, no X11/Wayland compositor
# required. Recommended default for this always-on kiosk use case. The
# platform is chosen here, via environment, not compiled into the binary --
# the same executable also runs correctly on desktop Linux/macOS with no
# QT_QPA_PLATFORM override at all (Qt auto-detects xcb/wayland/cocoa there).
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/qqcs/kms.json
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
# No mouse in normal operation (CEC/remote only) -- eglfs otherwise
# always composites a virtual cursor on top, with no input device to
# ever move it away from its startup position.
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QQCS_CONFIG=/etc/qqcs/config.yaml
ExecStart=/usr/bin/qqcs
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qqcs

[Install]
WantedBy=graphical.target
